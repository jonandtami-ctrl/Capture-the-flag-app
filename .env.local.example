# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that should receive form submissions (e.g. jonandtami@gmail.com)
MINISTRY_NOTIFICATION_EMAIL=

# "From" address for outgoing notification emails.
# Until a sending domain is verified in Resend, leave this unset to use
# Resend's shared "onboarding@resend.dev" address, which can deliver to
# any inbox without domain setup. Once you verify your own domain in
# Resend, switch this to something like forms@yourministrydomain.org.
MINISTRY_FROM_EMAIL=
